# OpenAlex API key (required for cursor paging)
OPENALEX_API_KEY=

# Optional caller contact email
OPENALEX_MAILTO=

# Rolling display window in years
DISPLAY_YEARS=5

# Maximum pages per search query (100 works per page)
MAX_PAGES_PER_QUERY=8

# Stop pagination below this remaining-credit threshold
MIN_REMAINING_CREDITS=50

# rescan | incremental (incremental requires a paid OpenAlex plan)
SYNC_MODE=rescan
